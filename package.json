{
  "name": "dianxiaoqi-extension",
  "description": "店小七 Chrome MV3 extension",
  "private": true,
  "version": "0.0.50",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "type": "module",
  "scripts": {
    "dev": "mkdir -p wxt-chrome-data && wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/*.test.mjs",
    "compile": "tsc --noEmit",
    "verify": "npm run test && npm run compile && npm run build",
    "data:wxshop-categories": "node scripts/fetch-wxshop-categories.mjs",
    "data:category-map:itemcats": "node scripts/build-taobao-itemcat-wxshop-category-map.mjs",
    "push": "npm run verify && npm version patch -m 'chore: v%s' && git push --follow-tags",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.3",
    "@tanstack/react-query": "^5.100.11",
    "antd": "^6.4.3",
    "axios": "^1.18.1",
    "dexie": "^4.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^14.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "wxt": "^0.20.26"
  }
}
